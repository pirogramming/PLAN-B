# =====================================================================
# Django 기본 설정
# =====================================================================
SECRET_KEY=change-this-to-your-local-secret-key
DEBUG=True

# =====================================================================
# 데이터베이스
# =====================================================================
# 로컬 개발: SQLite 그대로 사용 (아래 값 유지하면 됨)
# 배포(Cloud Run): Neon 커넥션 문자열로 교체
#   예) postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL=sqlite:///db.sqlite3

# =====================================================================
# 접속 허용 도메인 / CSRF (배포 시에만 실제 값 필요)
# =====================================================================
# 이 앱이 응답할 도메인 목록 (콤마로 구분, 공백 없이)
# 로컬 개발은 아래 기본값 그대로 두면 됨
ALLOWED_HOSTS=localhost,127.0.0.1

# 로그인/폼 제출(POST) 시 CSRF 검증을 통과시킬 origin 목록
# 로컬은 비워둬도 되지만, 배포 시엔 반드시 실제 도메인을 https:// 포함해서 넣어야 함
#   예) CSRF_TRUSTED_ORIGINS=https://plan-b-xxxxx-an.a.run.app
CSRF_TRUSTED_ORIGINS=

# HTTP 요청을 HTTPS로 강제 리다이렉트할지 여부
# 로컬 개발 서버는 HTTPS가 아니므로 반드시 False로 둘 것
# 배포 시엔 True (또는 아예 이 줄 삭제 → 기본값 True)
SECURE_SSL_REDIRECT=False

# =====================================================================
# AI 분석 (task_extractor) - Google Gemini
# =====================================================================
# https://aistudio.google.com 에서 무료 API 키 발급
GOOGLE_API_KEY=your-google-api-key-here
AI_MODEL_NAME=gemini-3.1-flash-lite

# True: 실제 API 호출 없이 고정 샘플 응답 사용 (비용 0원, 로컬 개발 기본값)
# False: 실제 API 호출 (비용 발생) — 응답 품질 확인할 때만 잠깐 켤 것
AI_MOCK_MODE=True

# =====================================================================
# 소셜 로그인 - Google OAuth
# =====================================================================
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# =====================================================================
# 소셜 로그인 - Naver OAuth
# =====================================================================
# Naver Developers(developers.naver.com)에서 발급
NAVER_CLIENT_ID=your-naver-client-id
NAVER_CLIENT_SECRET=your-naver-client-secret

# =====================================================================
# 파일 저장소 (PDF 업로드)
# =====================================================================
# False: 로컬 디스크(media/)에 저장 (로컬 개발 기본값)
# True: GCS 버킷에 저장 (배포 시 필수 — Cloud Run은 재배포마다 로컬 파일이 사라짐)
USE_GCS=False

# USE_GCS=True일 때만 필요. 배포 시 GCP에서 만든 버킷 이름 입력
#   예) GS_BUCKET_NAME=plan-b-media
GS_BUCKET_NAME=